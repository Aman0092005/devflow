PORT=4000
DATABASE_URL=postgres://devflow:devflow@localhost:5432/devflow
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173

# GitHub integration (see README / chat for how to create the OAuth app)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/github/callback
# Encrypts stored GitHub tokens. Use a long random string and keep it stable.
TOKEN_ENCRYPTION_KEY=change-me-to-another-long-random-string

# AI assistant: free key from https://aistudio.google.com (Get API key)
GEMINI_API_KEY=
# One or more model names, comma-separated and tried in order. Google retires models often, so check AI Studio.
GEMINI_MODEL=gemini-flash-latest,gemini-3.1-flash-lite
AI_HOURLY_LIMIT=20
